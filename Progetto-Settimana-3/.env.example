# Copia questo file in .env e compila i valori. .env NON va committato.

# URL JDBC del database PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/socialnetworkII
# Utente del database
DB_USERNAME=postgres
# Password del database
DB_PASSWORD=
# Chiave per firmare i JWT: stringa casuale di almeno 32 caratteri
JWT_SECRET=
